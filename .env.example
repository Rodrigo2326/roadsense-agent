# RoadSense - copia a .env y ajusta. NUNCA pongas claves reales aqui.
AWS_REGION=us-east-1

# Bedrock: modelo verificado disponible en la cuenta (inference profile)
ROADSENSE_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Strands Decider 2B: checkpoint HuggingFace y dispositivo de inferencia
ROADSENSE_DECIDER_CHECKPOINT=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
ROADSENSE_DECIDER_DEVICE=cpu

# Limite duro de decisiones por pregunta (guardrail del brief, seccion 5)
ROADSENSE_MAX_STEPS=4

# Credenciales: NO se definen aqui.
# Local  -> usa ~/.aws/credentials (perfil default)
# EC2    -> usa el instance profile roadsense-ec2-profile
